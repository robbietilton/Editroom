    },
    " the requested length is %lld seconds, but the footage adds up to about %lld seconds": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目标时长是 %lld 秒，素材合计约 %lld 秒"
