{
  "sourceLanguage": "en",
  "strings": {
    "\n\nLocate one and any others in the same folder are found too.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n定位其中一个文件后，同一文件夹中的其他缺失文件也会一并找回。"
          }
        }
      }
    },
    " (%@ had no sound and were left unchanged)": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "（%@ 无声，已保留原有音量）"
          }
        }
      }
    },
    " Install ffmpeg to import formats macOS can't decode.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": " 请安装 ffmpeg 以导入 macOS 无法解码的格式。"
          }
        }
      }
    },
    " and ": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "，并"
          }
        }
      }
    },
    " from %@": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "（来自 %@）"
          }
        }
      }
    },
    " from %@ and %@": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "（来自 %@ 和 %@）"
